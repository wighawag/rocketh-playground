{
  "name": "rocketh-playground",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "devDependencies": {
    "dorfl": "0.16.0",
    "ldenv": "^0.6.0",
    "set-defaults": "^0.0.5",
    "syncpack": "^15.3.3",
    "zellij-launcher": "^0.0.1"
  },
  "scripts": {
    "prepare": "set-defaults .vscode",
    "preinstall": "npx only-allow pnpm",
    "---------------------- INSTALL ----------------------": "",
    "sync-deps": "syncpack fix-mismatches",
    "---------------------- DEV ----------------------": "",
    "web:dev": "ldenv pnpm --filter ./web dev",
    "web:build": "ldenv pnpm --filter ./web build",
    "---------------------- TEST ----------------------": "",
    "web:check": "pnpm --filter ./web check",
    "web:test": "pnpm --filter ./web test",
    "web:e2e": "pnpm --filter ./web e2e",
    "web:budgets": "pnpm --filter ./web budgets",
    "test": "pnpm web:test",
    "test:export": "pnpm --filter ./web test:export",
    "-- 'test:export' installs and deploys the project Download exports: -----": "",
    "-- it needs the network and takes minutes, so 'verify' does not run it --": "",
    "verify": "pnpm web:check && pnpm web:test && pnpm web:build && pnpm web:budgets && pnpm web:e2e",
    "-- 'verify' is what a green tree means. No CI config ships with this --": "",
    "-- template on purpose: wire 'pnpm verify' into whatever CI you use ----": "",
    "-- 'web:budgets' fails a build whose bundles outgrew their budgets ----": "",
    "-- (web/scripts/bundle-budgets.mjs), so it runs after 'web:build' -----": "",
    "-- 'web:e2e' runs Playwright against the build 'web:build' just made: ---": "",
    "-- it needs Chromium once per machine (pnpm --filter ./web exec ---------": "",
    "-- playwright install chromium) -----------------------------------------": "",
    "---------------------- DEPLOY ----------------------": "",
    "build": "pnpm web:build",
    "serve": "pnpm run --filter ./web serve",
    "---------------------- RUN FULL LOCAL SETUP ----------------------": "",
    "stop": "zellij kill-session $npm_package_name",
    "start:pnpm": "pnpm -r dev",
    "start": "zellij-launcher a $npm_package_name || zellij -n zellij.kdl -s $npm_package_name"
  }
}
